#!/bin/bash
# Erneuert nach jedem Commit die Ansicht des Registers (build/truth_ansicht.html,
# gitignored). Laeuft erst nach dem Commit und kann ihn nicht aufhalten; schlaegt
# die Ansicht fehl, gibt es nur einen Hinweis. post-merge, post-checkout und
# post-rewrite rufen diese Datei ebenfalls, damit die Ansicht auch nach pull,
# Branchwechsel und rebase zum Arbeitsbaum passt.
for s in tools/truth_ansicht.py tools/scripts/truth_ansicht.py; do
  if [ -f "$s" ]; then
    python3 "$s" --leise || echo "Hinweis: Register-Ansicht nicht erneuert ($s)." >&2
    break
  fi
done
# Kartenkarte (build/card_map.html): Lage der Bereiche auf der Karte und Update-Weg,
# nur aus entschiedenen Registerzeilen. Bricht das Skript ab, ist eine dort zitierte
# Zeile kein Fakt mehr; dann die Tabellen in tools/scripts/card_map.py nachziehen.
if [ -f tools/scripts/card_map.py ]; then
  python3 tools/scripts/card_map.py --leise || echo "Hinweis: Kartenkarte nicht erneuert (siehe oben)." >&2
fi
exit 0
